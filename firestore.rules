rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    match /khatmas/{khatmaId} {
      // Anyone with direct Khatma link can read it
      allow get: if true;
      allow list: if false;

      // Create: Authenticated user creating their own Khatma with valid initial state
      allow create: if request.auth != null &&
                       request.resource.data.id == khatmaId &&
                       request.resource.data.creatorUid == request.auth.uid &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() >= 1 &&
                       request.resource.data.title.size() <= 120 &&
                       request.resource.data.completedCount == 0 &&
                       request.resource.data.reservedCount == 0 &&
                       request.resource.data.juzs is map &&
                       request.resource.data.juzs.keys().size() == 30;

      // Update: Authenticated user reserving or completing a Juz
      allow update: if request.auth != null &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.creatorUid == resource.data.creatorUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.title == resource.data.title &&
                       request.resource.data.juzs is map &&
                       request.resource.data.juzs.keys().size() == 30 &&
                       request.resource.data.completedCount is int &&
                       request.resource.data.completedCount >= 0 &&
                       request.resource.data.completedCount <= 30 &&
                       request.resource.data.reservedCount is int &&
                       request.resource.data.reservedCount >= 0 &&
                       request.resource.data.reservedCount <= 30;

      // Delete: Never allowed
      allow delete: if false;
    }
  }
}
